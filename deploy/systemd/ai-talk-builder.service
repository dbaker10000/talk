[Unit]
Description=AI Talk Builder Flask app
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/ai-talk-builder
EnvironmentFile=/home/ubuntu/ai-talk-builder/.env
ExecStart=/home/ubuntu/ai-talk-builder/.venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
